#include <iostream>
#include <cstring>
using namespace std;

int main() {
    char s[100001];
    cin >> s;

    bool ok = true;

    for(int i = 0; s[i] != '\0'; i++) {
        if(s[i] < 'a' || s[i] > 'z') {
            ok = false;
            break;
        }
    }

    cout << (ok ? "YES" : "NO");

    return 0;
}
