import java.util.*;
class Main{
 public static void main(String[]z){
  Scanner s=new Scanner(System.in);
  int n=s.nextInt();
  int[][] c=new int[n][26];
  for(int i=0;i<n;i++){
   for(char x:s.next().toCharArray())c[i][x-'a']++;
  }
  StringBuilder r=new StringBuilder();
  for(int j=0;j<26;j++){
   int m=Integer.MAX_VALUE;
   for(int i=0;i<n;i++)m=Math.min(m,c[i][j]);
   while(m-->0)r.append((char)('a'+j));
  }
  System.out.print(r);
 }
}
