import java.util.*;
class Main{
 public static void main(String[]z){
  Scanner s=new Scanner(System.in);
  int t=s.nextInt();
  while(t-->0){
   int n=s.nextInt(),c=0;
   int[] a=new int[n];
   for(int i=0;i<n;i++){a[i]=s.nextInt();if(a[i]==0)c++;}
   if(c<2)System.out.println(-1);
   else System.out.println(a[0]+a[n-1]);
  }
 }
}
