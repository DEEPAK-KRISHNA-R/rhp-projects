import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int k = sc.nextInt();
        int q = sc.nextInt();

        int MAX = 200000;

        int[] diff = new int[MAX + 2];

        for (int i = 0; i < n; i++) {
            int l = sc.nextInt();
            int r = sc.nextInt();

            diff[l]++;
            diff[r + 1]--;
        }

        int[] good = new int[MAX + 1];
        int curr = 0;

        for (int i = 1; i <= MAX; i++) {
            curr += diff[i];

            if (curr >= k)
                good[i] = 1;
        }

        int[] prefix = new int[MAX + 1];

        for (int i = 1; i <= MAX; i++) {
            prefix[i] = prefix[i - 1] + good[i];
        }

        StringBuilder sb = new StringBuilder();

        while (q-- > 0) {
            int a = sc.nextInt();
            int b = sc.nextInt();

            sb.append(prefix[b] - prefix[a - 1]).append("\n");
        }

        System.out.print(sb);
    }
}
