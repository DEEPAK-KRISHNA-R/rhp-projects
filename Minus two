import java.util.*;
class Main{
 public static void main(String[]z){
  Scanner s=new Scanner(System.in);
  int t=s.nextInt();
  while(t-->0){
   int n=s.nextInt(),a=0,b=0,c=0,d=0;
   while(n-->0){
    int x=s.nextInt()%4;
    if(x==0)a++;else if(x==1)b++;else if(x==2)c++;else d++;
   }
   System.out.println(Math.max(Math.max(a,c),b+d));
  }
 }
}
