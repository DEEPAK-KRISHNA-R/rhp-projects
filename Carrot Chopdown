import java.util.*;
class Main{
 public static void main(String[]z){
  Scanner s=new Scanner(System.in);
  int t=s.nextInt();
  while(t-->0){
   int n=s.nextInt(),m=s.nextInt(),r=0;
   int[] f=new int[m+1];
   while(n-->0)f[s.nextInt()]++;
   for(int x=1;x<=m;x++){
    int a=0;
    for(int i=x;i<=m;i+=x)a+=f[i];
    int b=0;
    for(int i=2*x;i<=m;i+=x)b+=f[i];
    r=Math.max(r,a+b);
   }
   System.out.println(r);
  }
 }
}
