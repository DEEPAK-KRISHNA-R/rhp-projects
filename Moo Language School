import java.util.*;
class Main{
 public static void main(String[]z){
  Scanner s=new Scanner(System.in);
  int t=s.nextInt();
  while(t-->0){
   int n=s.nextInt(),k=s.nextInt(),r=0;
   String x=s.next();
   for(int i=0;i<n;i+=k){
    boolean ok=true;
    for(int j=i;j<i+k;j++)if(x.charAt(j)=='0')ok=false;
    if(ok)r++;
   }
   System.out.println(r);
  }
 }
}
