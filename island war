import java.util.*;
class Main{
 public static void main(String[]z){
  Scanner s=new Scanner(System.in);
  int n=s.nextInt(),m=s.nextInt();
  int[][] a=new int[m][2];
  for(int[]x:a){x[0]=s.nextInt();x[1]=s.nextInt();}
  Arrays.sort(a,(x,y)->x[1]-y[1]);
  int last=-1,r=0;
  for(int[]x:a)if(x[0]>=last){r++;last=x[1];}
  System.out.print(r);
 }
}
