import java.util.*;
class Main{
 public static void main(String[]z){
  Scanner s=new Scanner(System.in);
  int n=s.nextInt();
  long[] a=new long[n],b=new long[n];
  int p=-1;
  for(int i=0;i<n;i++){a[i]=s.nextLong();b[i]=s.nextLong();if(a[i]>b[i])p=i;}
  if(p<0)System.out.println("No");
  else{
   System.out.println("Yes");
   for(int i=0;i<n;i++)System.out.print((i==p?1000000000000000000L:1)+" ");
  }
 }
}
