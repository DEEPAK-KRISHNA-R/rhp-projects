import java.util.*;
class Main{
 public static void main(String[]z){
  Scanner s=new Scanner(System.in);
  int n=s.nextInt(),q=s.nextInt();
  int[] p=new int[n+q],pos=new int[n+1];
  for(int i=0;i<n;i++){p[i]=s.nextInt();pos[p[i]]=i;}
  int len=n;
  while(q-->0){
   int x=s.nextInt(),i=pos[x];
   p[i]=-1;p[len]=x;pos[x]=len++;
  }
  for(int x:p)if(x!=-1)System.out.print(x+" ");
 }
}
